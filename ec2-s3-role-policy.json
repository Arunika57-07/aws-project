{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProjectBucketOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE-BUCKET-NAME"
    },
    {
      "Sid": "ReadWriteObjectsInProjectBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE-BUCKET-NAME/*"
    }
  ]
}
